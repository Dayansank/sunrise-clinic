<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Patient portal · Sunrise Dental Clinic</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body class="app-body">
<div class="util-bar no-print">
    <div>
        <span>Logged in</span>
        <span>Phone <strong>+94 11 234 5678</strong></span>
    </div>
    <div>12 Galle Road, Colombo 03</div>
</div>
<header class="topbar no-print">
    <a class="brand" href="${pageContext.request.contextPath}/patient-home">
        <span class="brand-mark">S</span>
        <div>
            <strong>Sunrise Dental Clinic</strong>
            <small>Patient portal</small>
        </div>
    </a>
    <nav class="nav">
        <a href="${pageContext.request.contextPath}/patient-home">Home</a>
        <a href="${pageContext.request.contextPath}/patient-book">Book</a>
        <a href="${pageContext.request.contextPath}/patient-appointments">My visits</a>
        <a href="${pageContext.request.contextPath}/patient-bills">My bills</a>
        <a class="btn orange" href="${pageContext.request.contextPath}/patient-book">Book appointment</a>
        <a class="danger" href="${pageContext.request.contextPath}/logout">Logout</a>
    </nav>
    <div class="who">
        <c:if test="${not empty sessionScope.patientUser}">
            <span>${sessionScope.patientUser.name}</span>
            <em>Patient</em>
        </c:if>
    </div>
</header>
<main class="page">
