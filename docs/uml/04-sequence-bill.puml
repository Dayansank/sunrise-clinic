@startuml Sunrise_Sequence_Bill
title Sequence Diagram - Calculate and print a bill

actor "Reception staff" as Rec
participant "BillServlet" as S
participant "BillingService" as BS
participant "AppointmentDAO" as ADAO
participant "AppointmentState" as ST
participant "ConsultationFeeConfig\n(Singleton)" as FEE
participant "StandardBillingStrategy" as STR
participant "BillDAO" as BDAO
database "MySQL" as DB

Rec -> S : enter appointment number
activate S
S -> BS : createBill(SCN-0007)
activate BS

BS -> ADAO : findByNumber(SCN-0007)
ADAO -> DB : SELECT appointment
DB --> ADAO : appointment + treatment cost
ADAO --> BS : appointment

BS -> ST : canBill() ?
ST --> BS : yes if status is BOOKED

BS -> FEE : getFee()
FEE -> DB : SELECT clinic_settings
DB --> FEE : 1500.00
FEE --> BS : consultation fee

BS -> STR : calculate(treatmentCost, fee)
STR --> BS : total

BS -> BDAO : insert(bill)
BDAO -> DB : INSERT bills
DB --> BDAO : bill id
BDAO --> BS : saved

BS -> ADAO : markCompleted()
ADAO -> DB : UPDATE status = COMPLETED
ADAO --> BS

BS --> S : bill
deactivate BS
S --> Rec : show bill page (print)
deactivate S

note over Rec, DB
  If a bill already exists I do not charge again.
  I just load the old bill and let them print it.
end note

@enduml
